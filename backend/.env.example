# Google Gemini API Key
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Whisper STT, optional)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Security (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,https://mallog24.vercel.app,https://mallog24.com,https://www.mallog24.com,https://ours.mallog24.com
# Optional regex (if set, this is used instead of CORS_ALLOW_ORIGINS)
CORS_ALLOW_ORIGIN_REGEX=
OAUTH_REDIRECT_ALLOW_HOSTS=localhost,127.0.0.1,mallog24.vercel.app,www.mallog24.vercel.app,mallog24.com,www.mallog24.com,ours.mallog24.com
OAUTH_REDIRECT_ALLOW_SCHEMES=http,https,mallog24,exp

# Rate limit (per RATE_LIMIT_WINDOW_SECONDS)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL=180
RATE_LIMIT_AUTH=30
RATE_LIMIT_TRANSCRIBE=10
# Supabase Auth network timeout (seconds)
AUTH_TIMEOUT=20
AUTH_CONNECT_TIMEOUT=8
AUTH_USER_CACHE_TTL_SECONDS=20
# Concurrent login limit per account (0 = disable, 1 = single active session)
AUTH_MAX_CONCURRENT_SESSIONS=1
# Session tracking retention seconds for concurrent login control
AUTH_SESSION_STALE_SECONDS=2592000
AUTH_COOKIE_NAME=mallog24_session
# Optional cookie domain. Leave empty to scope cookie to the API host only.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
# none recommended for production HTTPS cross-origin fetch; local HTTP will automatically downgrade to lax.
AUTH_COOKIE_SAMESITE=none
# Leave empty for auto-detection, or set true/false explicitly.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_MAX_AGE_SECONDS=2592000
TASK_STATUS_TTL_SECONDS=3600
MAX_AUTH_USER_CACHE_SIZE=2000
MAX_RATE_LIMIT_BUCKETS=2000
# Heavy transcription jobs run concurrently up to this count (1 recommended on low-memory instance)
MAX_CONCURRENT_TRANSCRIPTIONS=1
# If queued/processing exceeds this duration, status endpoint marks task as error (seconds)
TASK_STUCK_TIMEOUT_SECONDS=7200
# auto | whisper_gemini | gemini_only
TRANSCRIPTION_ENGINE_MODE=auto
# Whisper chunk call timeout/retry controls
WHISPER_CHUNK_TIMEOUT_SECONDS=240
WHISPER_CHUNK_MAX_RETRIES=2
# If true, automatically fallback to Gemini-only when Whisper step fails
WHISPER_FALLBACK_TO_GEMINI_ON_ERROR=true
# In auto/whisper_gemini, skip Whisper pipeline for files longer than this (seconds). 0 disables guard.
WHISPER_MAX_PIPELINE_AUDIO_SECONDS=2400
# ffmpeg/ffprobe subprocess timeout guards
FFMPEG_PROCESS_TIMEOUT_SECONDS=300
FFPROBE_PROCESS_TIMEOUT_SECONDS=30
# Gemini request/runtime guards
GEMINI_REQUEST_TIMEOUT_SECONDS=600
GEMINI_MAX_OUTPUT_TOKENS=32768
# Set true to print stage-by-stage memory usage logs during transcription
ENABLE_MEMORY_STAGE_LOG=false
# Force Python garbage collection after each transcription task
FORCE_GC_AFTER_TRANSCRIPTION=true

# Input limits
MAX_UPLOAD_BYTES=104857600
MAX_TEXT_INPUT_CHARS=120000
MAX_RECORD_CONTENT_CHARS=80000
FREE_MONTHLY_LIMIT_SECONDS=36000
USAGE_TIMEZONE=Asia/Seoul
ADMIN_BYPASS_USER_IDS=
ADMIN_BYPASS_EMAILS=hyunw2o@naver.com,rlagusdn17@gmail.com

# Billing (Domestic PG first, Stripe later)
BILLING_PROVIDER=portone
# If true, /api/billing/checkout always uses mock checkout screen
# (takes priority over live PortOne/Stripe credentials).
BILLING_TEST_MODE=false
MOCK_CHECKOUT_SESSION_TTL_SECONDS=1800
# Domestic PG (PortOne first)
PORTONE_STORE_ID=
# Alias for PORTONE_STORE_ID (if your portal labels this as MID)
PORTONE_MID=
PORTONE_CHANNEL_KEY=
# Optional dedicated channel for KakaoPay (if empty, PORTONE_CHANNEL_KEY is reused)
PORTONE_KAKAOPAY_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_API_BASE_URL=https://api.portone.io
# PortOne checkout flow: billing_key (정기과금 심사 권장) | payment (일반결제)
PORTONE_CHECKOUT_FLOW=billing_key
# Default pay method for checkout API: card | kakaopay
PORTONE_DEFAULT_PAY_METHOD=card
# If true, billing_key 발급 성공 시 즉시 pro 활성화. false면 billing_key_issued 상태만 저장(권장).
PORTONE_ACTIVATE_ON_BILLING_KEY_ISSUE=false
PAID_PLAN_AMOUNT_KRW=8800
PAID_PLAN_PRODUCT_NAME_KO=mallog24 Pro 월간 구독
PAID_PLAN_PRODUCT_NAME_EN=mallog24 Pro Monthly Subscription
# Optional direct Toss Payments
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Stripe (for global expansion later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
PAID_PLAN_TIER=pro
BILLING_REFUND_WINDOW_DAYS=7
# Optional redirect URLs (if empty, backend builds defaults from request host)
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=

# Debug endpoints
EXPOSE_TERMS_ENDPOINT=false
# If true, logs available Gemini model list at startup (can slow cold start)
LOG_GEMINI_MODELS_ON_STARTUP=false

# Optional public landing stats (leave empty to show "preparing data" placeholders)
LANDING_STATS_HOURS_PROCESSED=
LANDING_STATS_BETA_USERS=
LANDING_STATS_AVG_TURNAROUND_KO=
LANDING_STATS_AVG_TURNAROUND_EN=
LANDING_STATS_TIME_SAVING_KO=
LANDING_STATS_TIME_SAVING_EN=
LANDING_STATS_UPDATED_AT=
