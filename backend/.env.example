# Google Gemini API Key
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Whisper STT, optional)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Security (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,https://mallog24.vercel.app
# Optional regex (if set, this is used instead of CORS_ALLOW_ORIGINS)
CORS_ALLOW_ORIGIN_REGEX=
OAUTH_REDIRECT_ALLOW_HOSTS=localhost,127.0.0.1,mallog24.vercel.app

# Rate limit (per RATE_LIMIT_WINDOW_SECONDS)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL=180
RATE_LIMIT_AUTH=30
RATE_LIMIT_TRANSCRIBE=10

# Input limits
MAX_UPLOAD_BYTES=104857600
MAX_TEXT_INPUT_CHARS=120000
MAX_RECORD_CONTENT_CHARS=80000

# Debug endpoints
EXPOSE_TERMS_ENDPOINT=false
