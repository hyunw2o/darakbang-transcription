{
  "expo": {
    "name": "mallog24",
    "slug": "mallog24-mobile-shell",
    "version": "1.1.3",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "mallog24",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.mallog24.app",
      "buildNumber": "1.1.3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "mallog24에서 음성을 녹음해 텍스트로 변환하려면 마이크 접근 권한이 필요합니다."
      },
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      }
    },
    "android": {
      "versionCode": 20,
      "package": "com.mallog24.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1431"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1431"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "ededfb72-03c2-406b-82e4-c3681e781aa5"
      }
    },
    "owner": "hyun_w_k",
    "plugins": [
      "expo-apple-authentication",
      "expo-iap",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "mallog24에서 음성을 녹음해 텍스트로 변환하려면 마이크 접근 권한이 필요합니다.",
          "recordAudioAndroid": true
        }
      ],
      "expo-asset"
    ]
  }
}
